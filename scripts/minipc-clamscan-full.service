[Unit]
Description=Scheduled full ClamAV scan (Mini-PC Monitor)
After=clamav-daemon.service
Requires=clamav-daemon.service

[Service]
Type=oneshot
Environment=MINIPC_CLAM_TRIGGER=scheduled
Environment=MINIPC_CLAM_HISTORY=/mnt/storage/logs/clamav-scan-history.jsonl
ExecStart=/usr/local/sbin/minipc-clamscan-admin start shared

[Install]
WantedBy=multi-user.target
