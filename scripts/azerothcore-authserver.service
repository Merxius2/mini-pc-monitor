[Unit]
Description=AzerothCore Auth Server
After=network-online.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=sylvester
WorkingDirectory=/home/sylvester/azerothcore/server/bin
ExecStart=/home/sylvester/azerothcore/server/bin/authserver
Restart=on-failure
RestartSec=5

[Install]
WantedBy=azerothcore.target
