#!/bin/bash
# Samba user admin for Mini-PC Monitor (run via passwordless sudo only).
set -euo pipefail

SHARE_GROUP="${MINIPC_SAMBA_GROUP:-storage-apps}"
SHARE_PATH="${MINIPC_SAMBA_PATH:-/mnt/storage/shared}"
SHARE_NAME="${MINIPC_SAMBA_SHARE:-storage}"
ACCESS_FILE="${MINIPC_SAMBA_ACCESS_FILE:-/etc/mini-pc-monitor/samba-access.json}"
ACCESS_CONF="${MINIPC_SAMBA_ACCESS_CONF:-/etc/samba/smb.d/storage-access.conf}"

usage() {
  echo "Usage: $0 list | list-json | add USER PASS [read|write] | remove USER | set-access USER read|write | set-password USER PASS" >&2
  exit 1
}

valid_user() {
  [[ "$1" =~ ^[a-z][a-z0-9_-]{0,31}$ ]]
}

valid_access() {
  [[ "$1" == "read" || "$1" == "write" ]]
}

smb_users() {
  pdbedit -L 2>/dev/null | cut -d: -f1 | sort
}

access_load() {
  ACCESS_FILE="$ACCESS_FILE" python3 <<'PY'
import json
import os
from pathlib import Path

path = Path(os.environ["ACCESS_FILE"])
if not path.is_file():
    print("{}")
else:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        data = {}
    if not isinstance(data, dict):
        data = {}
    print(json.dumps(data))
PY
}

access_save() {
  ACCESS_FILE="$ACCESS_FILE" python3 <<'PY'
import json
import os
import sys
from pathlib import Path

path = Path(os.environ["ACCESS_FILE"])
path.parent.mkdir(parents=True, exist_ok=True)
data = json.loads(sys.stdin.read() or "{}")
if not isinstance(data, dict):
    raise SystemExit("invalid access payload")
path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
}

apply_access_conf() {
  SHARE_NAME="$SHARE_NAME" ACCESS_FILE="$ACCESS_FILE" ACCESS_CONF="$ACCESS_CONF" python3 <<'PY'
import json
import os
import subprocess
from pathlib import Path

share = os.environ["SHARE_NAME"]
access_path = Path(os.environ["ACCESS_FILE"])
conf_path = Path(os.environ["ACCESS_CONF"])

access: dict[str, str] = {}
if access_path.is_file():
    try:
        raw = json.loads(access_path.read_text(encoding="utf-8"))
        if isinstance(raw, dict):
            access = {k: v for k, v in raw.items() if v in ("read", "write")}
    except json.JSONDecodeError:
        access = {}

listed = subprocess.run(["pdbedit", "-L"], capture_output=True, text=True, check=False)
users = []
for line in (listed.stdout or "").splitlines():
    name = line.split(":", 1)[0].strip()
    if name:
        users.append(name)

read_users = sorted(u for u in users if access.get(u, "write") == "read")
lines = [
    "# Generated by minipc-samba-admin — do not edit manually",
    f"[{share}]",
]
if read_users:
    lines.append("   read list = " + ", ".join(read_users))
else:
    lines.append("   ; no read-only users")

conf_path.parent.mkdir(parents=True, exist_ok=True)
conf_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
  if command -v testparm >/dev/null 2>&1; then
    testparm -s >/dev/null 2>&1 || { echo "Samba config invalid after access update" >&2; exit 1; }
  fi
  systemctl reload smbd.service 2>/dev/null || systemctl restart smbd.service
}

cmd="${1:-}"
case "$cmd" in
  list)
    smb_users
    ;;
  list-json)
    ACCESS_FILE="$ACCESS_FILE" python3 <<'PY'
import json
import os
import subprocess
from pathlib import Path

access_path = Path(os.environ["ACCESS_FILE"])
access: dict[str, str] = {}
if access_path.is_file():
    try:
        raw = json.loads(access_path.read_text(encoding="utf-8"))
        if isinstance(raw, dict):
            access = raw
    except json.JSONDecodeError:
        pass

listed = subprocess.run(["pdbedit", "-L"], capture_output=True, text=True, check=False)
users = []
for line in (listed.stdout or "").splitlines():
    name = line.split(":", 1)[0].strip()
    if name:
        users.append(name)

out = []
for name in sorted(users):
    mode = access.get(name, "write")
    if mode not in ("read", "write"):
        mode = "write"
    out.append({"username": name, "access": mode})
print(json.dumps(out))
PY
    ;;
  add)
    user="${2:-}"; pass="${3:-}"; access="${4:-write}"
    valid_user "$user" || { echo "Invalid username" >&2; exit 1; }
    [ -n "$pass" ] || { echo "Password required" >&2; exit 1; }
    valid_access "$access" || { echo "Access must be read or write" >&2; exit 1; }
    getent group "$SHARE_GROUP" >/dev/null || groupadd "$SHARE_GROUP"
    if ! id "$user" >/dev/null 2>&1; then
      useradd -M -s /usr/sbin/nologin -G "$SHARE_GROUP" "$user"
    else
      usermod -aG "$SHARE_GROUP" "$user" 2>/dev/null || true
    fi
    printf '%s\n%s\n' "$pass" "$pass" | smbpasswd -a -s "$user"
    smbpasswd -e "$user" >/dev/null
    chown -R root:"$SHARE_GROUP" "$SHARE_PATH"
    chmod -R g+rwX "$SHARE_PATH"
    data="$(access_load)"
    printf '%s' "$data" | ACCESS_FILE="$ACCESS_FILE" python3 - "$user" "$access" <<'PY'
import json
import os
import sys
from pathlib import Path

user, access = sys.argv[1], sys.argv[2]
data = json.loads(sys.stdin.read() or "{}")
if not isinstance(data, dict):
    data = {}
data[user] = access
path = Path(os.environ["ACCESS_FILE"])
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
    apply_access_conf
    ;;
  remove)
    user="${2:-}"
    valid_user "$user" || { echo "Invalid username" >&2; exit 1; }
    smbpasswd -x "$user" 2>/dev/null || true
    if id "$user" >/dev/null 2>&1; then
      userdel "$user" 2>/dev/null || true
    fi
    data="$(access_load)"
    printf '%s' "$data" | ACCESS_FILE="$ACCESS_FILE" python3 - "$user" <<'PY'
import json
import os
import sys
from pathlib import Path

user = sys.argv[1]
data = json.loads(sys.stdin.read() or "{}")
if isinstance(data, dict):
    data.pop(user, None)
path = Path(os.environ["ACCESS_FILE"])
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
    apply_access_conf
    ;;
  set-access)
    user="${2:-}"; access="${3:-}"
    valid_user "$user" || { echo "Invalid username" >&2; exit 1; }
    valid_access "$access" || { echo "Access must be read or write" >&2; exit 1; }
    if ! smb_users | grep -Fxq "$user"; then
      echo "Samba user not found: $user" >&2
      exit 1
    fi
    data="$(access_load)"
    printf '%s' "$data" | ACCESS_FILE="$ACCESS_FILE" python3 - "$user" "$access" <<'PY'
import json
import os
import sys
from pathlib import Path

user, access = sys.argv[1], sys.argv[2]
data = json.loads(sys.stdin.read() or "{}")
if not isinstance(data, dict):
    data = {}
data[user] = access
path = Path(os.environ["ACCESS_FILE"])
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
    apply_access_conf
    ;;
  set-password)
    user="${2:-}"; pass="${3:-}"
    valid_user "$user" || { echo "Invalid username" >&2; exit 1; }
    [ -n "$pass" ] || { echo "Password required" >&2; exit 1; }
    if ! smb_users | grep -Fxq "$user"; then
      echo "Samba user not found: $user" >&2
      exit 1
    fi
    printf '%s\n%s\n' "$pass" "$pass" | smbpasswd -s "$user"
    smbpasswd -e "$user" >/dev/null
    ;;
  *)
    usage
    ;;
esac
