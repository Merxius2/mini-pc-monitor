# Mini-PC Monitor — storage stack (script validates subcommands)
sylvester ALL=(ALL) NOPASSWD: /usr/local/sbin/minipc-samba-admin
sylvester ALL=(ALL) NOPASSWD: /bin/systemctl start smbd.service, /bin/systemctl stop smbd.service, /bin/systemctl restart smbd.service
sylvester ALL=(ALL) NOPASSWD: /bin/systemctl start transmission-daemon.service, /bin/systemctl stop transmission-daemon.service, /bin/systemctl restart transmission-daemon.service
sylvester ALL=(ALL) NOPASSWD: /bin/systemctl start clamav-daemon.service, /bin/systemctl stop clamav-daemon.service, /bin/systemctl restart clamav-daemon.service
sylvester ALL=(ALL) NOPASSWD: /usr/local/sbin/minipc-clamscan-admin start downloads
sylvester ALL=(ALL) NOPASSWD: /usr/local/sbin/minipc-clamscan-admin start shared
sylvester ALL=(ALL) NOPASSWD: /usr/local/sbin/minipc-clamscan-admin status
sylvester ALL=(ALL) NOPASSWD: /usr/local/sbin/minipc-clamscan-admin run downloads
sylvester ALL=(ALL) NOPASSWD: /usr/local/sbin/minipc-clamscan-admin run shared
sylvester ALL=(ALL) NOPASSWD: /bin/mkdir -p /etc/systemd/system/minipc-clamscan-full.timer.d
sylvester ALL=(ALL) NOPASSWD: /bin/mkdir -p /etc/systemd/system/minipc-clamscan-full.service.d
sylvester ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/systemd/system/minipc-clamscan-full.timer.d/mini-pc-monitor.conf
sylvester ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/systemd/system/minipc-clamscan-full.service.d/mini-pc-monitor.conf
sylvester ALL=(ALL) NOPASSWD: /bin/systemctl daemon-reload
sylvester ALL=(ALL) NOPASSWD: /bin/systemctl enable minipc-clamscan-full.timer
sylvester ALL=(ALL) NOPASSWD: /bin/systemctl disable minipc-clamscan-full.timer
sylvester ALL=(ALL) NOPASSWD: /bin/systemctl restart minipc-clamscan-full.timer
sylvester ALL=(ALL) NOPASSWD: /bin/systemctl start minipc-clamscan-full.timer
sylvester ALL=(ALL) NOPASSWD: /bin/systemctl stop minipc-clamscan-full.timer
