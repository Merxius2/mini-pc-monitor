[Unit]
Description=Mini-PC Monitor web dashboard
After=network.target
Documentation=https://github.com/Merxius2/mini-pc-monitor/blob/main/docs/mini-pc.md

[Service]
Type=simple
User=sylvester
Group=sylvester
WorkingDirectory=/home/sylvester/mini-pc-monitor
ExecStart=/home/sylvester/mini-pc-monitor/scripts/serve-dashboard.sh
Restart=on-failure
RestartSec=5
Environment=DASHBOARD_HOST=0.0.0.0
Environment=DASHBOARD_PORT=8080

[Install]
WantedBy=multi-user.target
